function _pxTxt(bytes) { return Utilities.newBlob(bytes).getDataAsString('UTF-8'); }
function _pxBytes(str) { return Utilities.newBlob(str, 'text/plain').getBytes(); }
function _pxSha256(bytes) { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes).map(function(b){ return ('0' + (b & 255).toString(16)).slice(-2); }).join(''); }

