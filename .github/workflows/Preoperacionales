  if (accion === 'emergency' || accion === 'logout') return {allowed: true, reason: 'always_available'};
  if (accion === 'history' || accion === 'close') return {allowed: true, reason: 'check_resource_permissions'};
  if (!asignacion) return {allowed: accion === 'operate', reason: 'not_assigned'};
  if (asignacion.user_id !== usuario) return {allowed: false, reason: 'wrong_assignment_owner'};
  var propios = registros.filter(function(r){ return r.user_id === usuario && r.template_id === asignacion.template_id; });
  var pendiente = propios.some(function(r){ return r.day < hoy && !r.closed; });
  var actual = propios.some(function(r){ return r.day === hoy && r.signed; });
  if (accion === 'open') {
