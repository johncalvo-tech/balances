// ── Colaborador: cierre (avance parcial o final con confirmacion). Un cierre finalizado no se sobrescribe. ──
function cerrarPreop(token, d) {
  var sess = getSession(token);
  if (!sess) return {ok: false, msg: 'Sesion invalida'};
  d = d || {};
