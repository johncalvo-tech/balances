// El administrador sube el Excel maestro (preop_moto.xlsx / preop_vehicle.xlsx). Queda en Drive y se usa como plantilla.
// Solo se acepta el maestro autorizado (SHA-256): el mapeo de celdas depende de su distribucion exacta.
function subirPlantillaPreop(token, tipo, base64, nombre) {
  var sess = getSession(token);
  if (!sess || !esAdmin(sess.rol)) return {ok: false, msg: 'Sin permiso'};
  if (!PREOP_MAPEO[tipo]) return {ok: false, msg: 'Formato no valido.'};
  var bytes; try { bytes = Utilities.base64Decode(String(base64 || '')); } catch (e) { return {ok: false, msg: 'Archivo invalido.'}; }
  try { _pxInspeccionar(bytes); } catch (eI) { return {ok: false, msg: eI.message + (/macros/.test(eI.message) ? ' Sube el archivo preop_' + tipo + '.xlsx (no el .xlsm original).' : '')}; }
  var sha = _pxSha256(bytes);
  if (sha !== PREOP_HASH[tipo]) {
    var otro = sha === PREOP_HASH[tipo === 'moto' ? 'vehicle' : 'moto'];
    return {ok: false, msg: otro ? 'Ese archivo es la plantilla de ' + PREOP_NOMBRE[tipo === 'moto' ? 'vehicle' : 'moto'] + ', no de ' + PREOP_NOMBRE[tipo] + '.' :
      'Este archivo no es el maestro autorizado de ' + PREOP_NOMBRE[tipo] + ' (preop_' + tipo + '.xlsx). Un formato distinto requiere una nueva version del mapeo y nuevas pruebas antes de usarlo.'};
  }
  try { _pxRutaHoja(_pxUnzip(bytes), PREOP_HOJA[tipo]); } catch (eH) { return {ok: false, msg: eH.message}; }
  var carp = _pxCarpeta(['Plantillas']);
  var f = carp.createFile(Utilities.newBlob(bytes, 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'preop_' + tipo + '.xlsx'));
  var props = PropertiesService.getScriptProperties(), viejo = props.getProperty('PX_MAESTRO_' + tipo);
  props.setProperty('PX_MAESTRO_' + tipo, f.getId());
  props.setProperty('PX_MAESTRO_' + tipo + '_FECHA', Utilities.formatDate(new Date(), TZ_BOGOTA, 'dd/MM/yyyy HH:mm'));
  props.setProperty('PX_MAESTRO_' + tipo + '_POR', sess.nombre || sess.usuario);
  if (viejo && viejo !== f.getId()) { try { DriveApp.getFileById(viejo).setTrashed(true); } catch (eV) {} }
  auditar(sess, 'PREOP_PLANTILLA', tipo + ' ' + (nombre || '') + ' sha ' + sha.slice(0, 12));
  return {ok: true, url: f.getUrl(), sha: sha};
}
