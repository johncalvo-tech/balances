    if (propios.some(function(r){ return r.day === hoy; })) return {allowed: false, reason: 'already_registered_today'};
    return {allowed: true, reason: 'opening_available'};
  }
  if (!asignacion.required_today) return {allowed: true, reason: 'not_required_today'};
  if (pendiente) return {allowed: false, reason: 'previous_closure_pending'};
  if (!actual) return {allowed: false, reason: 'daily_signed_opening_required'};
